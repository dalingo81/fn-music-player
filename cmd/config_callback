#!/bin/bash

# ══════════════════════════════════════════════════
# 配置变更回调脚本
# ══════════════════════════════════════════════════
# 触发时机：
# 1. 用户在「应用设置」中修改端口（wizard_port 变更）
# 2. 用户在「应用设置」中修改授权文件夹（TRIM_DATA_ACCESSIBLE_PATHS 变更）
#
# 注意：授权文件夹路径由飞牛系统自行注入为 TRIM_DATA_ACCESSIBLE_PATHS 环境变量，
# 无需在此脚本中手动维护路径列表。cmd/main 启动 Node 服务时直接从环境变量读取。
# ══════════════════════════════════════════════════

PORT="${wizard_port:-6688}"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${TRIM_PKGVAR}/info.log"
}

log_msg "Config changed: PORT=${PORT}"
log_msg "Authorized folders (from system): ${TRIM_DATA_ACCESSIBLE_PATHS}"

# 保存端口配置（授权路径无需保存，由系统环境变量动态传递）
mkdir -p "${TRIM_PKGETC}"
cat > "${TRIM_PKGETC}/settings.conf" <<EOF
PORT=${PORT}
EOF

# 重启应用使新配置生效
log_msg "Restarting application to apply config with PORT=${PORT}..."
bash "${0%/*}/main" stop
sleep 1
bash "${0%/*}/main" start

exit 0
